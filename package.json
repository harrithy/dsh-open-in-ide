{
  "name": "dsh-open-in-ide",
  "version": "0.2.0",
  "description": "Open file references from the DeepSeek Harness chat output in your IDE (VS Code family or JetBrains, Visual Studio Code by default), positioned at the referenced line.",
  "type": "module",
  "license": "MIT",
  "author": "harrithy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrithy/dsh-open-in-ide.git"
  },
  "homepage": "https://github.com/harrithy/dsh-open-in-ide#readme",
  "bugs": {
    "url": "https://github.com/harrithy/dsh-open-in-ide/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vscode",
    "cursor",
    "jetbrains",
    "intellij",
    "pycharm",
    "webstorm",
    "ide",
    "editor"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
